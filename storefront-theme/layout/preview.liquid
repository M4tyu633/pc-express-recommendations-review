<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>PC Express | Personalization preview</title>
    <link rel="stylesheet" href="/preview.css">
    <link rel="stylesheet" href="/pcx-storefront.css">
    <script type="module" src="/preview.js"></script>
  </head>
  <body class="pcx-preview">
    {% render 'pcx-header', logo: logo, categories: categories %}
    <main id="MainContent">
      <div id="home-content">
        {% render 'pcx-home', slides: slides, categories: categories %}
      </div>
      <div class="shell preview-content">
        <section class="preview-controls" id="personalization-demo" aria-labelledby="personalization-heading">
          <div class="preview-controls-copy">
            <h2 id="personalization-heading">Try personalization</h2>
            <p>Compare the same product row for three sample shoppers.</p>
          </div>
          <button type="button" class="pcx-guide-open" aria-controls="pcx-demo-guide" aria-expanded="false" disabled>Open demo guide</button>
        </section>
        <p id="preview-status" role="status">Loading the demo catalog…</p>
        <div id="page-context"></div>
        <div id="placements">{{ recommendations }}</div>
        <section class="sample-catalog" id="sample-catalog" aria-labelledby="catalog-heading">
          <h2 id="catalog-heading">Featured Products</h2>
          <div class="product-grid" id="catalog-grid"></div>
        </section>
        <noscript><p>Enable JavaScript to try personalization.</p></noscript>
      </div>
    </main>
    <button type="button" class="pcx-guide-open pcx-guide-launcher" aria-controls="pcx-demo-guide" aria-expanded="false" disabled>Demo guide</button>
    <section id="pcx-demo-guide" class="pcx-demo-guide" popover="manual" aria-labelledby="pcx-guide-title">
      <div class="pcx-guide-header">
        <h2 id="pcx-guide-title">How personalization works</h2>
        <button id="pcx-guide-close" type="button" aria-label="Close demo guide">&times;</button>
      </div>
      <p>Start with <strong>Bestsellers</strong>. Everyone sees these picks before sharing browsing activity.</p>
      <label class="pcx-guide-consent"><input type="checkbox" id="allow-personalization" disabled> Allow personalization</label>
      <p>Try both browsing examples. Watch the <strong>Recommended For You</strong> row change and read the reason under each product.</p>
      <div class="pcx-guide-samples" role="group" aria-label="Sample browsing">
        <button type="button" data-action="replay" data-id="gpu-mid" disabled>Graphics cards</button>
        <button type="button" data-action="replay" data-id="audio-usb" disabled>Headsets</button>
      </div>
      <p>For your own test, open any product from the catalog or use search, then check your Home picks.</p>
      <div class="pcx-guide-samples">
        <button type="button" data-action="browse" data-target="sample-catalog" disabled>Browse the catalog</button>
        <button type="button" data-action="browse" data-target="personalization-demo" disabled>See Home picks</button>
      </div>
      <div class="pcx-guide-footer">
        <p id="pcx-guide-result" role="status">Showing Bestsellers</p>
        <button id="reset-session" type="button" disabled>Reset demo</button>
      </div>
    </section>
    <footer id="pcx-preview-info" class="pcx-footer"><div class="shell">
      <img src="{{ logo | asset_url }}" alt="PC Express" width="162" height="36" loading="lazy">
      <p>Storefront demo. Prices are a catalog snapshot and the cart is simulated.</p>
      {% if operations %}<a href="/operations.html">Campaign operations</a>{% endif %}
    </div></footer>
    {% for product in products %}
      <template id="pcx-card-{{ product.id | escape }}">{% render 'pcx-product-card', product: product, actions: true %}</template>
    {% endfor %}
    <script type="application/json" id="pcx-preview-bootstrap">{{ bootstrap }}</script>
  </body>
</html>
