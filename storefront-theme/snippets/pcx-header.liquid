<div class="announcement-bar">
  <span>PC Express storefront preview</span>
  <a href="#personalization-demo">How recommendations work</a>
</div>
<header class="site-header" id="shopify-section-header-categories-menu">
  <div class="shell t4s-header__wrapper header-main">
    <button type="button" class="brand t4s-header__logo" data-action="navigate" data-surface="home" disabled aria-label="PC Express home">
      <img src="{{ logo | asset_url }}" alt="PC Express" width="225" height="50">
    </button>
    <form id="search-form" class="search-form" role="search">
      <label class="sr-only" for="search-query">Search for products</label>
      <input id="search-query" type="search" maxlength="80" placeholder="Search for products" disabled>
      <button type="submit" aria-label="Search" disabled><span class="search-icon" aria-hidden="true"></span></button>
    </form>
    <button type="button" class="cart-control" data-action="navigate" data-surface="cart" disabled>Cart <span id="cart-count">0</span></button>
  </div>
  <div class="pcx-menu">
    <div class="shell nav">
      <details class="pcx-categories">
        <summary><span aria-hidden="true">☰</span> All Products <span aria-hidden="true">⌄</span></summary>
        <div class="pcx-category-menu">
          {% for category in categories %}
            <button type="button" data-action="category" data-query="{{ category.query | escape }}" disabled>{{ category.label | escape }}</button>
          {% endfor %}
        </div>
      </details>
      <nav class="t4s-nav-ul" aria-label="Store categories">
        <button type="button" data-action="category" data-query="asus" disabled>Taiwan Excellence</button>
        <button type="button" data-action="category" data-query="radeon" disabled>AMD</button>
        <button type="button" data-action="category" data-query="asus" disabled>Powered by ASUS</button>
        <button type="button" data-action="category" data-query="desktop" disabled>ASUS Agent Computer</button>
        <button type="button" data-action="category" data-query="laptops" disabled>Laptops</button>
        <button type="button" data-action="category" data-query="desktop" disabled>Mini PCs</button>
        <button type="button" data-action="category" data-query="geforce" disabled>NVIDIA</button>
        <button type="button" data-action="category" data-query="intel" disabled>Intel</button>
        <button type="button" data-action="category" data-query="laptops" disabled>Microsoft</button>
        <button type="button" data-action="category" data-query="lenovo" disabled>Lenovo</button>
        <button type="button" data-action="category" data-query="msi" disabled>Powered by MSI</button>
        <button type="button" data-action="category" data-query="monitor" disabled>Samsung Monitors</button>
        <button type="button" data-action="category" data-query="desktop" disabled>Business Solutions</button>
        <button type="button" data-action="browse" data-target="sample-catalog" disabled>Pricelists</button>
        <button type="button" class="pcx-sale-link" data-action="category" data-query="laptops" disabled>Laptop Sale!</button>
        <button type="button" data-action="browse" data-target="sample-catalog" disabled>Product Spotlight</button>
        <button type="button" data-action="browse" data-target="home-content" disabled>News &amp; Promos</button>
        <a href="#pcx-preview-info">Info</a>
      </nav>
    </div>
  </div>
</header>
