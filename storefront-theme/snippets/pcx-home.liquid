<section class="shell t4s-slideshow" aria-label="Featured at PC Express" data-carousel>
  <div class="pcx-slide-track">
    {% for slide in slides %}
      <button type="button" class="pcx-banner" data-action="category" data-query="{{ slide.query | escape }}" disabled aria-label="{{ slide.label | escape }}">
        <picture>
          <source media="(max-width: 600px)" srcset="{{ slide.mobile | asset_url }}">
          <img src="{{ slide.desktop | asset_url }}" alt="{{ slide.label | escape }}" width="1440" height="480"
            {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        </picture>
      </button>
    {% endfor %}
  </div>
  <button type="button" class="pcx-slide-arrow pcx-slide-prev" aria-label="Previous promotion">‹</button>
  <button type="button" class="pcx-slide-arrow pcx-slide-next" aria-label="Next promotion">›</button>
  <div class="pcx-slide-dots" role="group" aria-label="Choose a promotion">
    {% for slide in slides %}
      <button type="button" class="pcx-slide-dot" aria-label="Show {{ slide.label | escape }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
    {% endfor %}
  </div>
</section>
<section class="shell pcx-category-section" aria-labelledby="categories-heading">
  <h2 id="categories-heading">Shop by Category</h2>
  <div class="pcx-category-grid">
    {% for category in categories %}
      <button type="button" data-action="category" data-query="{{ category.query | escape }}" disabled aria-label="{{ category.label | escape }}">
        <img src="{{ category.image | asset_url }}" alt="{{ category.label | escape }}" width="350" height="350" loading="lazy">
      </button>
    {% endfor %}
  </div>
</section>
